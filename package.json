{
  "name": "@jbpark/use-hooks",
  "version": "4.0.0",
  "description": "A collection of reusable React 19 hooks for common UI and interaction patterns",
  "keywords": [
    "react",
    "hooks",
    "typescript",
    "react-hooks",
    "utilities",
    "custom-hooks"
  ],
  "author": "jbpark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pjb0811/use-hooks.git"
  },
  "homepage": "https://github.com/pjb0811/use-hooks#readme",
  "bugs": {
    "url": "https://github.com/pjb0811/use-hooks/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsdown",
    "build:demo": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@jbpark/ui-kit": "^5.2.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write",
    "**/*.{js,jsx,ts,tsx}": [
      "bash -c 'pnpm lint'",
      "bash -c 'tsc -b'"
    ]
  }
}
